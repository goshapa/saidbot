# Токен бота, полученный у @BotFather
BOT_TOKEN=123456:AA...

# Telegram ID администраторов через запятую (узнать можно у @userinfobot)
ADMIN_IDS=111111111,222222222

# Чат/группа, куда бот будет присылать уведомления о новых заказах
# Можно указать тот же ID, что и первый ADMIN_IDS, если хотите личку
ADMIN_CHAT_ID=111111111

# Строка подключения к БД (по умолчанию — локальный SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/saidbot.db

# Валюта для отображения цен
CURRENCY=UZS

# Доступ к веб-админке (http://localhost:8000)
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=change_me
ADMIN_PANEL_SECRET=change_me_random_secret
